# Copy this file to apps/api/.env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://ledvara:ledvara@localhost:5432/ledvara
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Ledvara <no-reply@ledvara.local>
APP_BASE_URL=http://localhost:5173
# Generate a real one with: node -p "require('crypto').randomBytes(48).toString('base64url')"
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
TWO_FACTOR_ENCRYPTION_KEY=paste-the-64-characters-here